<Page x:Class="_122_Rogosin_UP02.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_122_Rogosin_UP02.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="189*"/>
            <ColumnDefinition Width="211*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource WhiteBrush}" 
                BorderBrush="{StaticResource PrimaryBrush}" 
                BorderThickness="2"
                CornerRadius="10"
                Width="350" 
                Height="366"
                VerticalAlignment="Center"
                HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="225,0,0,0">

            <StackPanel Margin="25" VerticalAlignment="Center">
                <TextBlock Text="Вход в систему" 
                          Style="{StaticResource HeaderStyle}"/>
                <TextBlock Text="Логин:" 
                          Style="{StaticResource SubHeaderStyle}"/>
                <TextBox x:Name="TextBoxLogin" 
                        Style="{StaticResource TextBoxFieldStyle}"
                        ToolTip="Введите ваш логин"
                        KeyDown="TextBoxLogin_KeyDown" Height="40"/>

                <TextBlock Text="Пароль:" 
                          Style="{StaticResource SubHeaderStyle}"
                          Margin="0,10,0,0"/>
                <PasswordBox x:Name="PasswordBox" 
                            Style="{StaticResource PasswordBoxFieldStyle}"
                            ToolTip="Введите ваш пароль"
                            KeyDown="PasswordBox_KeyDown" Height="40"/>
                <TextBlock x:Name="ErrorText" 
                          Text="Неверный логин или пароль" 
                          Style="{StaticResource ErrorTextStyle}"
                          Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Margin="0,20,0,0">
                    <Button x:Name="ButtonLogin" 
                            Content="Войти" 
                            Click="ButtonLogin_Click"
                            Style="{StaticResource ActionButtonStyle}"/>

                    <Button x:Name="ButtonRegister" 
                            Content="Регистрация" 
                            Click="ButtonRegister_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource SecondaryBrush}"/>
                </StackPanel>
                <TextBlock Text="или продолжить как гость" 
                          FontSize="12" 
                          Foreground="{StaticResource LightTextBrush}"
                          HorizontalAlignment="Center"
                          Margin="0,15,0,0"
                          Cursor="Hand"
                          MouseLeftButtonDown="GuestText_MouseLeftButtonDown" Height="49">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Page>
