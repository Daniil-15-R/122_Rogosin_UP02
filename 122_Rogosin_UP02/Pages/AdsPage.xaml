<Page x:Class="_122_Rogosin_UP02.Pages.AdsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_122_Rogosin_UP02.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Объявления"
      Loaded="Page_Loaded">

    <Grid Background="{StaticResource LightBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и фильтры -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="Объявления" 
                          Foreground="White" 
                          FontSize="20" 
                          FontWeight="Bold"
                          VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1" 
                         x:Name="FilterComboBox"
                         Width="150" 
                         Margin="10,0"
                         SelectionChanged="FilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все объявления" IsSelected="True"/>
                    <ComboBoxItem Content="Активные"/>
                    <ComboBoxItem Content="Завершенные"/>
                </ComboBox>

                <Button Grid.Column="2" 
                        x:Name="AddButton"
                        Content="Добавить объявление" 
                        Click="AddButton_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{StaticResource SuccessBrush}"/>
            </Grid>
        </Border>

        <!-- Список объявлений -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AdsItemsControl" Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1"
                                CornerRadius="5" 
                                Margin="0,5" 
                                Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок и цена -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                          Text="{Binding Ad_Title}" 
                                          FontSize="16" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource PrimaryBrush}"/>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                          Text="{Binding Price, StringFormat={}{0}₽}" 
                                          FontSize="16" 
                                          FontWeight="Bold"
                                          Foreground="{StaticResource SuccessBrush}"/>

                                <!-- Описание -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                          Text="{Binding Ad_Description}" 
                                          FontSize="12" 
                                          Margin="0,5,0,0"
                                          TextWrapping="Wrap"/>

                                <!-- Категория и город -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Orientation="Horizontal" 
                                           Margin="0,10,0,0">
                                    <Border Background="{StaticResource LightPrimaryBrush}" 
                                            CornerRadius="3" 
                                            Padding="5,2">
                                        <TextBlock Text="{Binding Category.CategoryName}" 
                                                  FontSize="10" 
                                                  Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>

                                    <Border Background="{StaticResource LightGrayBrush}" 
                                            CornerRadius="3" 
                                            Padding="5,2" 
                                            Margin="5,0,0,0">
                                        <TextBlock Text="{Binding City.CityName}" 
                                                  FontSize="10" 
                                                  Foreground="{StaticResource DarkTextBrush}"/>
                                    </Border>

                                    <Border Background="{Binding StatusColor}" 
                                            CornerRadius="3" 
                                            Padding="5,2" 
                                            Margin="5,0,0,0">
                                        <TextBlock Text="{Binding Ad_status}" 
                                                  FontSize="10" 
                                                  Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Дата и тип -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Orientation="Horizontal" 
                                           Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Ad_post_date, StringFormat={}{0:dd.MM.yyyy}}" 
                                              FontSize="10" 
                                              Foreground="{StaticResource LightTextBrush}"/>

                                    <TextBlock Text=" • " 
                                              FontSize="10" 
                                              Foreground="{StaticResource LightTextBrush}"/>

                                    <TextBlock Text="{Binding Ad_Type}" 
                                              FontSize="10" 
                                              Foreground="{StaticResource LightTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Background="{StaticResource LightGrayBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Загрузка..."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ElementName=AdsItemsControl, Path=Items.Count, StringFormat={}Объявлений: {0}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>