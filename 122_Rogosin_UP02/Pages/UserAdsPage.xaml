<Page x:Class="_122_Rogosin_UP02.Pages.UserAdsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_122_Rogosin_UP02.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Мои объявления">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки управления -->
        <Border Grid.Row="0" Background="{StaticResource LightPrimaryBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="Мои объявления" 
                          Style="{StaticResource LargeHeaderStyle}"
                          HorizontalAlignment="Left"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnCompletedAds" 
                            Content="Завершенные" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnCompletedAds_Click"/>
                    <Button x:Name="BtnAddAd" 
                            Content="Добавить" 
                            Style="{StaticResource ActionButtonStyle}"
                            Click="BtnAddAd_Click"/>
                    <Button x:Name="BtnBack" 
                            Content="Назад" 
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnBack_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список объявлений пользователя -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AdsPanel" Margin="16">
                <!-- Объявления будут добавляться динамически -->
            </StackPanel>
        </ScrollViewer>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Загрузка объявлений..."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>