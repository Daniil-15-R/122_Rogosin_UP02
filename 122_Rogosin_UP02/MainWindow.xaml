<Window x:Class="_122_Rogosin_UP02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_122_Rogosin_UP02"
        mc:Ignorable="d"
        Title="Сервис частных объявлений" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10" HorizontalAlignment="Right" Width="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Pages/Image/Лого.png" Width="20" Height="20" Margin="0,0,5,0"/>
                    <TextBlock Text="Объявления" 
                               Style="{StaticResource HeaderStyle}"
                               Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnHome" 
                            Content="Главная" 
                            Click="BtnHome_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="BtnMyAds" 
                            Content="Мои объявления" 
                            Click="BtnMyAds_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnCompleted" 
                            Content="Завершенные" 
                            Click="BtnCompleted_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLogin" 
                            Content="Войти" 
                            Click="BtnLogin_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="BtnBack" 
                            Content="Назад" 
                            Click="BtnBack_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" 
               Grid.Row="1" 
               NavigationUIVisibility="Hidden"
               Margin="10"/>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="DateTimeText" Text="Загрузка..."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="UserStatusText" Text="Не авторизован"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
